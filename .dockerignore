# ── VCS & IDE ──
.git
.gitignore
.github/
.vscode/
.devcontainer/
.idea/
.githooks/

# ── Python artifacts ──
**/__pycache__/
**/*.pyc
**/*.pyo
.venv/
.cache/
.pytest_cache/
.ruff_cache/

# ── Environment & secrets ──
.env
.env.*
secrets.env
secrets.env.example

# ── Node (rebuilt inside Docker) ──
**/node_modules/
frontend/dist/

# ── Not needed at runtime ──
data/
dataset/
CU/
examples/
docs/
tests/
scripts/
infra/

# ── Build artifacts ──
*.log
.tmp/
.build-context/
build-context.tar.gz
*.sarif
static/dist/
*.tfstate*
tfplan

# ── Files never needed in image ──
LICENSE
requirements.txt
*.md
!README.md
