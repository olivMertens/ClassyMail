# Copy to terraform.tfvars and fill in values
# subscription_id is optional: if omitted, Terraform uses the current Azure CLI subscription.

# subscription_id = "00000000-0000-0000-0000-000000000000"

# Required: container image for both Container Apps
# Example:
# container_image = "myregistry.azurecr.io/ClassyMail-agent:local"

# Optional: if using a private ACR and want Terraform to grant AcrPull to the managed identity
# acr_name = "myregistry"
# acr_resource_group = "my-acr-rg"

# Optional: models availability is tenant/region-dependent
# enable_model_deployments = false

# Optional: Deploy Azure AI Language service for native PII detection
# Uses Standard (S) tier. Adds ~$2.50/month base + $1/1K text records.
# Enables native PII detection API as alternative to LLM-based detection.
# deploy_language_service = false

# Recommended in policy-driven tenants (disables Cosmos local auth + uses Cosmos SQL RBAC)
# cosmos_use_rbac = true

# Optional: organization/destination name for UI branding
# organization_name = "G2S"
# organization_name = "Groupama"
