{
  "description": "Insurance email/PDF classifier for G2S (Studio-safe version)",
  "baseAnalyzerId": "prebuilt-document",
  "models": {
    "completion": "gpt-4.1-mini",
    "embedding": "text-embedding-3-small"
  },
  "config": {
    "enableSegment": false,
    "estimateFieldSourceAndConfidence": true,
    "returnDetails": true
  },
  "fieldSchema": {
    "fields": {
      "Category": {
        "type": "string",
        "method": "classify",
        "description": "Insurance document category",
        "enum": [
          "Attestation habitation",
          "Releve de compte",
          "Attestation scolaire",
          "Dommages electriques",
          "Evenements naturels"
        ]
      },
      "Subject": {
        "type": "string",
        "method": "generate",
        "description": "Subject of the email or document"
      },
      "Sender": {
        "type": "string",
        "method": "generate",
        "description": "Name or organization of the sender"
      },
      "Summary": {
        "type": "string",
        "method": "generate",
        "description": "Brief summary of the document content"
      },
      "Entities": {
        "type": "array",
        "description": "Key business entities found in the document",
        "items": {
          "type": "object",
          "properties": {
            "Name": {
              "type": "string",
              "description": "Name of the entity"
            },
            "Type": {
              "type": "string",
              "method": "classify",
              "enum": [
                "Person",
                "Organization",
                "Date",
                "Amount",
                "Reference"
              ]
            }
          }
        }
      }
    }
  }
}
