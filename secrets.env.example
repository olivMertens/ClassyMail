# Exemple de configuration locale (POC)
# Copiez en secrets.env puis adaptez si besoin.
#
# IMPORTANT: ne committez jamais secrets.env. Le fichier est déjà dans .gitignore.

# --- Services Azure ---
AZURE_SERVICE_BUS_FQDN=email-poc-sbus.servicebus.windows.net
AZURE_SERVICE_BUS_QUEUE=pdf-processing-queue

AZURE_STORAGE_ACCOUNT_URL=https://emailpocst.blob.core.windows.net/
AZURE_STORAGE_CONTAINER=pdf-inputs

AZURE_COSMOS_ENDPOINT=https://email-poc-cosmos.documents.azure.com:443/
AZURE_COSMOS_DB=emailsdb
AZURE_COSMOS_CONTAINER=emails

# Cosmos key (uniquement si RBAC data-plane est désactivé)
# AZURE_COSMOS_KEY=<cosmos-primary-key>

# --- Identité (Azure Container Apps) ---
# Si l'app tourne sur Azure avec une User Assigned Managed Identity,
# définissez AZURE_CLIENT_ID = clientId de l'identité (Terraform output: APP_ID_CLIENT_ID)
AZURE_CLIENT_ID=3ae24af5-97c6-437f-a4d2-521fbd5524d4

# --- Azure AI Foundry / Azure OpenAI compatible endpoint ---
# Terraform output: AI_ENDPOINT
AZURE_AI_ENDPOINT=https://email-poc-aifoundry.cognitiveservices.azure.com/

# Endpoints des modèles (par défaut on pointe vers l'endpoint Foundry)
MISTRAL_ENDPOINT=${AZURE_AI_ENDPOINT}
MISTRAL_DEPLOYMENT=mistral-ocr-2505
MISTRAL_MODE=maas

PHI_ENDPOINT=${AZURE_AI_ENDPOINT}
PHI_DEPLOYMENT=phi-4

# --- Coûts (UI) ---
PHI4_COST_PER_1K_INPUT=0.000107
PHI4_COST_PER_1K_OUTPUT=0.00043
MISTRAL_OCR_COST_PER_1K_PAGES=1.0

# --- Observabilité ---
# Exemple: http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=

# Log Analytics Workspace ID for querying Application Insights logs
# Available from Terraform output or Azure Portal > Log Analytics Workspace > Properties > Workspace ID
# Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LOG_ANALYTICS_WORKSPACE_ID=
